{
  "name": "token-weather",
  "private": true,
  "version": "0.1.0",
  "description": "Token Weather — local AI usage and auth dashboard CLI (monorepo)",
  "license": "Apache-2.0",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "echo \"TODO: wire dev commands\"",
    "build": "echo \"TODO: wire build commands\"",
    "lint": "echo \"TODO: wire lint commands\"",
    "test": "node --test packages/agent/test/**/*.test.js packages/provider-adapters/test/**/*.test.js packages/schemas/test/**/*.test.js",
    "test:schemas": "node --test packages/schemas/test/**/*.test.js",
    "test:agent": "node --test packages/agent/test/**/*.test.js",
    "test:adapters": "node --test packages/provider-adapters/test/**/*.test.js",
    "agent:status": "node ./packages/agent/bin/ai-usage-agent.js status",
    "agent:usage": "node ./packages/agent/bin/ai-usage-agent.js usage",
    "agent:doctor": "node ./packages/agent/bin/ai-usage-agent.js doctor",
    "agent:config:init": "node ./packages/agent/bin/ai-usage-agent.js config init"
  }
}
