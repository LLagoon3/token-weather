{
  "name": "token-weather",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Token Weather — local AI usage and auth dashboard CLI (monorepo)",
  "license": "Apache-2.0",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node ./packages/agent/bin/token-weather.js status",
    "build": "npm run build:types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test $(find packages/agent/test packages/provider-adapters/test packages/schemas/test packages/telegram/test -name '*.test.js')",
    "test:schemas": "node --test $(find packages/schemas/test -name '*.test.js')",
    "test:agent": "node --test $(find packages/agent/test -name '*.test.js')",
    "test:adapters": "node --test $(find packages/provider-adapters/test -name '*.test.js')",
    "test:telegram": "node --test $(find packages/telegram/test -name '*.test.js')",
    "cli:status": "node ./packages/agent/bin/token-weather.js status",
    "cli:usage": "node ./packages/agent/bin/token-weather.js usage",
    "cli:doctor": "node ./packages/agent/bin/token-weather.js doctor",
    "cli:config:init": "node ./packages/agent/bin/token-weather.js config init",
    "build:types": "npm -w @token-weather/schemas run build:types && npm -w @token-weather/provider-adapters run build:types && npm -w @token-weather/cli run build:types && npm -w @token-weather/telegram run build:types"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
